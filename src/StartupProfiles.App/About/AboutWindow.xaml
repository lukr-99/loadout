<Window x:Class="StartupProfiles.App.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Startup Profiles" Width="520" Height="760" MinWidth="460" MinHeight="520"
        Icon="pack://application:,,,/StartupProfiles;component/Assets/app.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Background="{DynamicResource App.Background}"
        TextElement.Foreground="{DynamicResource App.Text}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Root" Margin="28,24,28,28">

      <!-- Hero -->
      <StackPanel HorizontalAlignment="Center" Margin="0,4,0,22">
        <Border Width="84" Height="84" CornerRadius="22" HorizontalAlignment="Center"
                Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Accent}" BorderThickness="2">
          <Image Source="pack://application:,,,/StartupProfiles;component/Assets/app.ico" Width="48" Height="48"
                 RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <TextBlock x:Name="NameText" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold"
                   HorizontalAlignment="Center" Margin="0,2,0,0" />
        <TextBlock x:Name="TaglineText" Foreground="{DynamicResource App.Muted}"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" MaxWidth="400"
                   Foreground="{DynamicResource App.Muted}" />
      </StackPanel>

      <!-- Author card: an accent edge and a soft accent wash set it apart from the plain cards below. -->
      <Border CornerRadius="14" Padding="0" Margin="0,0,0,22"
              Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Accent}" BorderThickness="1.5">
        <Grid>
          <Border CornerRadius="13" Opacity="0.12" Background="{DynamicResource App.Accent}" />
          <StackPanel Margin="22,20,22,20">
            <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                       Foreground="{DynamicResource App.Accent}" HorizontalAlignment="Center" />
            <TextBlock x:Name="AuthorText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,6,0,0" />
            <TextBlock x:Name="FeedbackText"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"
                       Foreground="{DynamicResource App.Muted}" />
            <ItemsControl x:Name="LinkList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Tag="{Binding Url}" Click="OnLinkClick" Margin="0,0,0,8" Padding="14,10"
                          AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Url}">
                    <TextBlock>
                      <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" />
                      <Run Text="  ·  " Foreground="{DynamicResource App.Muted}" />
                      <Run Text="{Binding Handle, Mode=OneWay}" Foreground="{DynamicResource App.Muted}" />
                    </TextBlock>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Facts -->
      <TextBlock Text="About the app" Style="{StaticResource App.SettingGroup}" />
      <Border Style="{StaticResource App.SettingCard}">
        <StackPanel>
          <ItemsControl x:Name="FactList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="90" Foreground="{DynamicResource App.Muted}" />
                  <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource App.SettingHint}">
            <Hyperlink x:Name="LicenceLink" RequestNavigate="OnLicenceClick"
                       Foreground="{DynamicResource App.Accent}">Read the licence</Hyperlink>
          </TextBlock>
        </StackPanel>
      </Border>

      <!-- Credits -->
      <TextBlock Text="Credits" Style="{StaticResource App.SettingGroup}" />
      <Border Style="{StaticResource App.SettingCard}">
        <ItemsControl x:Name="CreditList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,4">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Licence}" Foreground="{DynamicResource App.Muted}"
                             FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="170" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Text="{Binding Role}" Style="{StaticResource App.SettingHint}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
